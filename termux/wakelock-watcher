#!/usr/bin/env bash
# Hold the Android wake-lock while Claude Code is ACTIVELY working, so
# an agent turn survives the screen being turned off mid-task — while
# an interactive session idling at its prompt releases the lock and
# lets the device sleep.
#
# Activity = CPU-time growth across claude processes AND all their
# descendants (so a turn waiting on a long Bash-tool child still counts
# as active). proot guest processes are ordinary host processes, so
# host-side /proc sees everything.
set -u

INTERVAL="${WAKELOCK_WATCH_INTERVAL:-30}"
# CPU growth (jiffies; 100 = 1s) per sample below which claude counts
# as idle. An active turn burns far more than 1s CPU per 30s window.
IDLE_THRESHOLD="${WAKELOCK_IDLE_THRESHOLD:-100}"
# Consecutive idle samples before the lock is released.
IDLE_SAMPLES="${WAKELOCK_IDLE_SAMPLES:-3}"

# Sum utime+stime over every claude process and its descendants.
# /proc/<pid>/stat is parsed past the ")" so comms with spaces are safe.
active_cpu() {
  local roots pids p sum=0 j
  roots=$(pgrep -f '(^|/| )claude( |$)' 2>/dev/null | tr '\n' ' ')
  if [ -z "$roots" ]; then
    echo 0
    return
  fi
  pids=$(ps -e -o pid=,ppid= 2>/dev/null | awk -v roots="$roots" '
    BEGIN { n = split(roots, r, " "); for (i = 1; i <= n; i++) mark[r[i]] = 1 }
    { pid[NR] = $1; par[NR] = $2 }
    END {
      changed = 1
      while (changed) {
        changed = 0
        for (i = 1; i <= NR; i++)
          if (!mark[pid[i]] && mark[par[i]]) { mark[pid[i]] = 1; changed = 1 }
      }
      for (p in mark) print p
    }')
  for p in $pids; do
    j=$(awk '{ i = index($0, ") "); split(substr($0, i + 2), a, " "); print a[12] + a[13] }' \
        "/proc/$p/stat" 2>/dev/null) || continue
    sum=$((sum + ${j:-0}))
  done
  echo "$sum"
}

LOCKED=0
prev=-1
idle_count=0

while true; do
  cur=$(active_cpu)
  if [ "$cur" -eq 0 ]; then
    # No claude at all — release immediately.
    idle_count=$IDLE_SAMPLES
  elif [ "$prev" -lt 0 ] || [ "$cur" -lt "$prev" ]; then
    # First sample or the process set changed — assume active.
    idle_count=0
  elif [ $((cur - prev)) -lt "$IDLE_THRESHOLD" ]; then
    idle_count=$((idle_count + 1))
  else
    idle_count=0
  fi
  prev=$cur

  if [ "$cur" -gt 0 ] && [ "$idle_count" -eq 0 ]; then
    if [ "$LOCKED" = 0 ]; then
      termux-wake-lock 2>/dev/null || true
      LOCKED=1
    fi
  elif [ "$idle_count" -ge "$IDLE_SAMPLES" ] && [ "$LOCKED" = 1 ]; then
    termux-wake-unlock 2>/dev/null || true
    LOCKED=0
  fi
  sleep "$INTERVAL"
done
